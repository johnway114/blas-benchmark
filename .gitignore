# Virtualenv, caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.omp/

# Credentials
.env

# Downloaded corpora and built eval sets: fetched from upstream by
# `bench.py prepare`, never redistributed. Committed manifests pin their
# hashes.
data/
eval/

# Run outputs. Hypotheses AND their receipts are committed: a receipt proves
# which bytes were scored, so without those bytes a clean checkout cannot
# re-verify a published number, only take our word for it. The line-level
# cache is a local optimisation and stays out.
out/cache/

# scores/ and archive/ are committed: they are the published record.
