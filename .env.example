# Copy to .env and fill in what you have. Every key is optional: systems
# whose key is missing are skipped by `run --all-ready` and reported as
# MISSING_KEY by `doctor`. No key is ever required for the local open-weight
# anchors (nllb-600m, opus-mt-cel, madlad400-3b).

# OpenAI (gpt-5.6-sol, gpt-5.6-luna)
OPENAI_API_KEY=

# Anthropic (claude-opus-5, claude-haiku-4-5)
ANTHROPIC_API_KEY=

# Google AI Studio key for Gemini chat models (gemini-3.1-pro, gemini-3.5-flash)
GEMINI_API_KEY=

# Google Cloud Translation API key (paid, official; NOT the free consumer
# endpoint). Enable "Cloud Translation API" on a billing-enabled project and
# create an API key restricted to it.
GOOGLE_TRANSLATE_API_KEY=

# DeepSeek (deepseek-chat alias -> current flagship chat model)
DEEPSEEK_API_KEY=

# Mistral (mistral-large-latest alias)
MISTRAL_API_KEY=
