# Copy to .env and fill in what you have. Every credential is optional:
# systems whose credentials are missing are skipped by `run --all-ready` and
# reported as MISSING_KEY by `doctor`. The open-weight local systems
# (opus-mt-cel, madlad400-3b, nllb-600m, qwen3.5-9b) need none at all.

# ---- General-purpose models -------------------------------------------
# OpenAI (gpt-5.6-sol, gpt-5.6-luna)
OPENAI_API_KEY=

# Anthropic (claude-opus-5, claude-haiku-4-5)
ANTHROPIC_API_KEY=

# Google AI Studio key for Gemini chat models (gemini-3.6-flash)
GEMINI_API_KEY=

# DeepSeek (deepseek-v4-pro, deepseek-v4-flash)
DEEPSEEK_API_KEY=

# Moonshot AI (kimi-k3)
MOONSHOT_API_KEY=

# Alibaba Model Studio, OpenAI-compatible mode (qwen3.7-max)
DASHSCOPE_API_KEY=

# ---- Dedicated translation services -----------------------------------
# Google Cloud Translation API key (paid, official; NOT the free consumer
# endpoint). Enable "Cloud Translation API" on a billing-enabled project and
# create an API key restricted to it.
GOOGLE_TRANSLATE_API_KEY=

# Google Cloud Translation LLM is a different product from both the NMT model
# above and the Gemini API: it is a translation-tuned model inside Cloud
# Translation Advanced, and it needs OAuth rather than an API key.
#   gcloud auth print-access-token
GOOGLE_CLOUD_ACCESS_TOKEN=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# DeepL API. A key ending in ":fx" is a Free key and is routed to the Free
# host automatically.
DEEPL_API_KEY=

# Azure AI Translator: key plus the region of the Translator resource.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# Amazon Translate: IAM credentials with translate:TranslateText.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Alibaba Cloud Machine Translation: AccessKey pair with the Machine
# Translation service activated. This is the only commercial API whose own
# language list contains Manx and Cornish.
ALIBABA_ACCESS_KEY_ID=
ALIBABA_ACCESS_KEY_SECRET=

# ---- Local weights ----------------------------------------------------
# Hugging Face token, only for gated local models (translategemma-4b,
# tiny-aya-water). You must accept each model's licence on its model page
# first; the harness never downloads gated weights anonymously.
HF_TOKEN=
